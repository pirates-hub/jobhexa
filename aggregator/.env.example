# Auto-import into the admin "Aggregator Inbox".
# After every run the aggregator POSTs data/jobs.json to this URL, so jobs
# appear in Admin -> Aggregator Inbox without manual uploads.
# AGG_SYNC_SECRET must match the server's AGG_SYNC_SECRET (server/.env).
# Leave both unset (or comment them out) to disable syncing.
AGG_SYNC_URL=http://localhost:5000/api/aggregator/sync
AGG_SYNC_SECRET=change-me

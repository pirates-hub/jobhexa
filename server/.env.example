PORT=5000
MONGODB_URI=mongodb://localhost:27017/jobhexa
NODE_ENV=development
# Public site URL (canonical links + /sitemap.xml + /robots.txt)
SITE_URL=http://localhost:5173
# CORS allowlist. Comma-separate apex, www and the onrender.com URL if needed.
FRONTEND_URL=http://localhost:5173
# Public API origin used to build OAuth callback URLs
BACKEND_URL=http://localhost:5000
# GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback
JWT_SECRET=your_super_secret_jwt_key_here
# Email — primary provider is Resend (HTTPS API, free 3,000/month, no card).
# 1) Create an API key at https://resend.com/api-keys
# 2) Verify jobhexa.com under Domains, or use onboarding@resend.dev for a test
#    to the Resend account owner only (other recipients get a 403).
RESEND_API_KEY=
RESEND_FROM=JobHexa <noreply@jobhexa.com>
# RESEND_REPLY_TO=support@jobhexa.com
# Provider chain: Resend -> SendGrid -> Brevo -> SMTP. To force a different
# first provider, set EMAIL_PROVIDER=resend|sendgrid|brevo|smtp.
# EMAIL_PROVIDER=resend
# MAIL_DRY_RUN=true logs sends without contacting a provider.
# MAIL_PAUSED=true stops all scheduled and manual mail.
# MAIL_SEND_DELAY_MS=350
# MAIL_BOOT_CATCHUP=true
# MAIL_SCHEDULER_DISABLED=false
# MAIL_MAX_ATTEMPTS=4

# SendGrid fallback (HTTPS, free 100/day). Verify a Single Sender first.
# SENDGRID_API_KEY=SG....
# SENDGRID_FROM=your_verified_sender@gmail.com
# SENDGRID_SENDER_NAME=JobHexa

# Brevo fallback. Disabled unless BREVO_ENABLED=true: the account was paused
# on 28 Oct and the API accepted mail without delivering it, hiding failures.
# BREVO_ENABLED=false
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=noreply@yourdomain.com
# BREVO_SENDER_NAME=JobHexa

# SMTP is for local development only. Render blocks outbound ports 587/465,
# so SMTP is excluded unless EMAIL_PROVIDER=smtp or ALLOW_SMTP=true.
# ALLOW_SMTP=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_gmail_app_password
# Gmail requires SMTP_FROM to match SMTP_USER; a custom domain is rewritten.
# SMTP_FROM=your_gmail@gmail.com
# For AWS SES use the SES SMTP host/user/password instead.

# AI via Groq cloud (free, no card, no local GPU):
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_from_console_groq_com
GROQ_MODEL=openai/gpt-oss-120b

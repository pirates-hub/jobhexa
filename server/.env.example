PORT=5000
MONGODB_URI=mongodb://localhost:27017/jobhexa
NODE_ENV=development
# Public site URL (canonical links + /sitemap.xml + /robots.txt)
SITE_URL=http://localhost:5173
# CORS allowlist. Comma-separate apex, www and the onrender.com URL if needed.
FRONTEND_URL=http://localhost:5173
# Public API origin used to build OAuth callback URLs
BACKEND_URL=http://localhost:5000
# GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback
JWT_SECRET=your_super_secret_jwt_key_here
# Gmail (for dev, 500/day)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
# Must equal SMTP_USER when sending through Gmail. A custom domain such as
# noreply@jobhexa.com is rewritten by Google and usually lands in Spam —
# only use it after adding and verifying the domain in your mail provider.
# The app adds the "JobHexa" display name automatically; this is just the address.
SMTP_FROM=your_gmail@gmail.com
# For production with AWS SES (uncomment and use SES SMTP):
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=AKIA... (SES SMTP user)
# SMTP_PASS=... (SES SMTP password)
# SMTP_FROM=noreply@jobhexa.com
# Brevo HTTP API (recommended on Render — uses port 443, no SMTP blocking).
# BREVO_API_KEY must be the v3 API key from Brevo → SMTP & API → API Keys
# (starts with xkeysib-). The SMTP key (xsmtpsib-…) will NOT work here.
# BREVO_SENDER_EMAIL must be verified in Brevo → Senders & IPs → Senders.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=noreply@yourdomain.com
# BREVO_SENDER_NAME=JobHexa
# Provider order. Default: SMTP first, Brevo on failure. Gmail SMTP sends as
# the account itself (SPF/DKIM aligned) so it reaches the inbox, while Brevo's
# shared relay is frequently spam-foldered. Set to `brevo` to reverse.
# EMAIL_PROVIDER=smtp
# SendGrid HTTPS API (port 443). Use this on hosts that block outbound SMTP
# (Render blocks 587 and 465, so Gmail SMTP cannot work there).
# Free tier: 100 mails/day, no card. Verify a Single Sender first, then the
# API key will send to any recipient.
# SENDGRID_API_KEY=SG....
# SENDGRID_FROM=your_verified_sender@gmail.com
# SENDGRID_SENDER_NAME=JobHexa
# AI via Groq cloud (free, no card, no local GPU):
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_from_console_groq_com
GROQ_MODEL=openai/gpt-oss-120b
